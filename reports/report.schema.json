{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://askpanoramix.com/reports/report.schema.json",
  "title":"Panoramix community research report v1",
  "type":"object",
  "required":["schemaVersion","reportId","submittedAt","author","license","summary","changes"],
  "additionalProperties":false,
  "properties":{
    "schemaVersion":{"const":1},
    "reportId":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "submittedAt":{"type":"string","format":"date"},
    "author":{"type":"string","minLength":1,"maxLength":200},
    "license":{"const":"MIT"},
    "summary":{"type":"string","minLength":1,"maxLength":5000},
    "changes":{
      "type":"array","minItems":1,"maxItems":100,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["toolId","set","expected","evidence"],
        "properties":{
          "toolId":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "set":{"$ref":"#/$defs/fields"},
          "expected":{"$ref":"#/$defs/expected"},
          "evidence":{"type":"array","items":{"$ref":"#/$defs/evidence"}}
        }
      }
    }
  },
  "$defs":{
    "fields":{
      "type":"object","minProperties":1,"additionalProperties":false,
      "properties":{
        "name":{"type":"string","minLength":1,"maxLength":5000},
        "family":{"enum":["agents","gateways","inference","media","gpu","cloud","models","coding","automation","creative"]},
        "description":{"type":"string","minLength":1,"maxLength":5000},
        "access":{"type":"string","minLength":1,"maxLength":5000},
        "features":{"type":"array","uniqueItems":true,"items":{"enum":["text","vision","image","video","audio","research","browser","code","connectors","schedule","routing","custom","selfhost","openai","visual"]}},
        "billing":{"type":"string","minLength":1,"maxLength":5000},
        "best":{"type":"string","minLength":1,"maxLength":5000},
        "watch":{"type":"string","minLength":1,"maxLength":5000},
        "source":{"type":"string","format":"uri","pattern":"^https://"},
        "extra":{"type":"string","format":"uri","pattern":"^https://"},
        "tags":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":200}}
      }
    },
    "expected":{
      "type":"object",
      "description":"Previous values copied exactly from catalog.json, one for each edited field. Empty for additions; null represents a previously absent optional field.",
      "propertyNames":{"enum":["name","family","description","access","features","billing","best","watch","source","extra","tags"]},
      "additionalProperties":{"type":["string","array","null"],"items":{"type":"string"}}
    },
    "evidence":{
      "type":"object","additionalProperties":false,
      "required":["field","url","checkedAt","note"],
      "properties":{
        "field":{"enum":["name","family","description","access","features","billing","best","watch","source","extra","tags"]},
        "url":{"type":"string","format":"uri","pattern":"^https://"},
        "checkedAt":{"type":"string","format":"date"},
        "note":{"type":"string","minLength":1,"maxLength":5000}
      }
    }
  }
}
